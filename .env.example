# MAXY configuration template. Copy to .env; never commit secrets.
MAXY_ENV=development
MAXY_HOST=127.0.0.1
MAXY_PORT=8765
MAXY_LOG_LEVEL=INFO

# Local inference
MAXY_LLM_PROVIDER=ollama
MAXY_OLLAMA_BASE_URL=http://127.0.0.1:11434
MAXY_OLLAMA_MODEL=llama3.2:1b

# Storage
MAXY_DATABASE_PATH=data/maxy.db

# Network access stays disabled until authenticated pairing is implemented.
MAXY_ALLOW_LAN=false

# Optional voice features (not implemented yet).
MAXY_VOICE_ENABLED=false
MAXY_WAKE_WORD_ENABLED=false
